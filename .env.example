# --- Generation provider -----------------------------------------------------
# simulated (default, keyless) | fal | runpod
VIDEO_PROVIDER=simulated

# --- fal.ai (required when VIDEO_PROVIDER=fal) --------------------------------
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# LTX-2 model id. Fast 1080p ≈ $0.04/s; Pro ≈ $0.06/s.
FAL_VIDEO_MODEL=fal-ai/ltx-2/text-to-video/fast

# --- LLM provider for the agent swarm -----------------------------------------
# Which inference backend to use.
#   gateway (default) → Vercel AI Gateway ("provider/model" strings)
#   groq             → Groq API (OpenAI-compatible, free tier available)
#   crusoe           → Crusoe Cloud Managed Inference (Nemotron)
#   openai           → Direct OpenAI API
LLM_PROVIDER=gateway

# --- AI Gateway ---------------------------------------------------------------
# API key for the Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Model string in "provider/model" format, e.g. "openai/gpt-4o-mini"
LLM_MODEL=openai/gpt-4o-mini

# --- Groq (when LLM_PROVIDER=groq) --------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq model — see https://console.groq.com/docs/models
# Recommend openai/gpt-oss-20b (native json_schema, 1000 t/s, $0.075/$0.30)
# Others: llama-3.3-70b-versatile, llama-3.1-8b-instant, meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=openai/gpt-oss-20b
# Per-agent model overrides (optional — unset = use GROQ_MODEL for all agents)
# NOTE: Llama models on Groq don't support json_schema; genObject falls back
# to text-gen + Zod parse automatically. For native json_schema, use GPT-OSS.
# LLM_MODEL_WRITER=llama-3.3-70b-versatile        # Screenwriter — creative writing
# LLM_MODEL_DIRECTOR=llama-3.3-70b-versatile       # Director — shot planning
# LLM_MODEL_DP=llama-3.3-70b-versatile             # Cinematographer — prompt crafting
# LLM_MODEL_EDITOR=llama-3.3-70b-versatile         # Editor — critical review
# LLM_MODEL_SOUND=llama-3.1-8b-instant             # Sound Designer — brief structured
# LLM_MODEL_SCORE=llama-3.1-8b-instant             # Composer — brief structured
# LLM_MODEL_COLOR=llama-3.1-8b-instant             # Colorist — brief structured

# --- OpenAI (when LLM_PROVIDER=openai) ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Crusoe Cloud Managed Inference (when LLM_PROVIDER=crusoe) -----------------
# Get a key at https://console.crusoecloud.com/request-foundry
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL=hack-crusoe/Nemotron-3-Nano-30B-A3B-FP8
